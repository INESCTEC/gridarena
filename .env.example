# Copy this file to .env and fill in real values. .env is git-ignored and
# loaded automatically at startup via python-dotenv (see gridarena/app.py).
# Full descriptions: docs/getting-started.md#configuration

# --- Required ---------------------------------------------------------
# PostgreSQL connection string. GRID_DB_DSN takes priority if both are set.
GRID_DB_DSN=postgresql://user:password@localhost:5432/gridarena
# DATABASE_URL=postgresql://user:password@localhost:5432/gridarena

# --- Optional: database connection pool --------------------------------
# DB_POOL_MIN_SIZE=2
# DB_POOL_MAX_SIZE=10

# --- Optional: CORS ------------------------------------------------------
# Comma-separated list of allowed origins.
# CORS_ORIGINS=http://localhost:5173

# --- Optional: benchmark noise generation ---------------------------------
# Unit for voltage-angle values in generated noise: "deg" or "rad".
# LVGPLAY_ANGLE_UNIT=deg

# --- Optional: LLM Chat assistant -----------------------------------------
# LLM_API_URL=https://cpes-llm.inesctec.pt/api
# LLM_API_KEY=
# LLM_MODEL=gemma4-31b
# LLM_VERIFY_SSL=false
# Exposes delete_grid / delete_measurements / delete_historical_database /
# delete_historical_series_records to the model. Off by default; even when on,
# each call still needs an explicit "confirmed" argument AND an affirmative
# reply from the user's own last message (see docs/api/chat.md).
# LVGPLAY_LLM_ENABLE_DESTRUCTIVE=0
# Per-tool-result and conversation-history size caps (chars / estimated tokens).
# LVGPLAY_LLM_MAX_TOOL_RESULT_CHARS=8000
# LVGPLAY_LLM_HISTORY_TOKEN_BUDGET=24000
# Max tool-call rounds per user turn before the assistant is forced to answer
# with whatever it has gathered so far.
# LVGPLAY_LLM_MAX_TOOL_ROUNDS=4
# Writable runtime state outside the installed package (document-assistant storage, etc.).
# LVGPLAY_DATA_DIR=./data/llm

# --- Optional: Document assistants (Phase 4B) ------------------------------
# Enables the document-assistant feature and its /chat/agents endpoints.
# LVGPLAY_ALLOW_DOCUMENT_AGENTS=0
# Per-file upload cap (MB) for attached Markdown documents.
# LVGPLAY_LLM_MAX_SOURCE_MB=5
# LVGPLAY_LLM_MAX_SOURCES_PER_AGENT=20
# How many excerpts are retrieved per question asked of a document assistant.
# LVGPLAY_LLM_DOC_CHUNKS_PER_ANSWER=6

# --- Optional: Digital Twin message broker --------------------------------
# REDIS_URL=redis://localhost:6379

# --- Digital Twin credentials (dynamic, not fixed names) ------------------
# Each digital twin's source_config.secret_ref names an environment variable
# that must hold that twin's own credential (e.g. an API token). There is no
# fixed variable name for this -- it is chosen per-twin when the twin is
# created via the API. See docs/api/digital-twin.md.
