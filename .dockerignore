# Version control
.git/
.gitignore

# Secrets — never bake these into an image layer. Pass equivalent values at
# `docker run` time via -e / --env-file instead.
.env
.env.*

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/
__pydantic_schema_cache__/

# Virtual environments
venv/
.venv/
env/
ENV/

# Logs and local databases
*.log
*.sqlite
*.sqlite3
*.db

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Grid data insertion scripts/datasets and generated docs (already gitignored)
database_creation/
claude_docs/

# Local run artifacts (regenerated at container startup)
gridarena/diffusion/runs/*
gridarena/rl/runs/*

# Docker-related files themselves
Dockerfile
.dockerignore
